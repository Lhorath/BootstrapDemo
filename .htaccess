<IfModule mod_rewrite.c>
    RewriteEngine On
    # If the site lives in a subdirectory, set this to that path (e.g. RewriteBase /myapp/)
    RewriteBase /

    # Serve real files and directories (CSS, JS, vendor assets) without routing.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Legacy PHP entry point → canonical fancy URL
    RewriteRule ^about\.php$ /about [R=301,L]

    # Default favicon request → same-origin SVG (avoids 404; keeps one asset to maintain)
    RewriteRule ^favicon\.ico$ /images/favicon.svg [L]

    # All other requests → front controller (paths parsed in PHP for /products/item-name, etc.)
    RewriteRule ^ index.php [L,QSA]
</IfModule>

DirectoryIndex index.php
